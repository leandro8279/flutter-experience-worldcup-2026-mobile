# Template de variaveis de ambiente.
# O .env e lido pelo proprio servidor, a partir da raiz (em dev, a raiz do
# projeto; no binario compilado, a raiz do bundle). Variaveis ja definidas no
# ambiente tem precedencia sobre o arquivo.
# Copie para .env e preencha o JWT_SECRET:
#   cp .env.example .env
# Gere um segredo forte (>= 256 bits):
#   openssl rand -base64 48

# Segredo simetrico do JWT (HS256, ADR-0004). Obrigatorio: o servidor sobe
# sem ele, mas jwtSecretFrom lanca StateError na primeira rota que usa JWT,
# devolvendo 500.
JWT_SECRET=troque-por-um-segredo-forte-de-pelo-menos-256-bits

# Opcionais (tem default no codigo se ausentes).
# DB_PATH default: ./data/wc_2026.db
DB_PATH=./data/wc_2026.db
# BCRYPT_COST default: 10
BCRYPT_COST=10
